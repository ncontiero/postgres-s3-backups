AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
S3_BUCKET="your-s3-bucket-name"
S3_REGION="your-s3-region"
# S3_ENDPOINT="https://your-s3-compatible-endpoint"

DATABASE_URL="postgresql://user:password@host:port/database"

# Optional: Cron expression used to schedule backups.
# BACKUP_CRON_SCHEDULE="0 0 * * *"

# Optional: Prefix used in generated backup filenames.
# BACKUP_FILE_PREFIX="backup"

# Optional: Number of days to keep backups before automatically deleting them.
# BACKUP_RETENTION_DAYS=5

# Optional: Subfolder used to store backups inside the bucket.
# BUCKET_SUBFOLDER="postgres"

# Optional: Extra options passed to pg_dump.
# BACKUP_OPTIONS="--no-owner --no-privileges"

# Optional: Run a backup immediately when the scheduler starts.
# RUN_ON_STARTUP=false

# Optional: Run one backup and exit instead of starting the scheduler.
# SINGLE_SHOT_MODE=false
