{
  "name": "postgres-s3-backups",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "description": "A simple utility to backup Postgres databases to S3 using Bun.",
  "author": {
    "name": "Nicolas Contiero",
    "url": "https://github.com/ncontiero"
  },
  "license": "MIT",
  "module": "src/index.ts",
  "scripts": {
    "build": "bun build --compile --minify --sourcemap src/index.ts --outfile postgres-s3-backup",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@t3-oss/env-core": "0.13.11",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@ncontiero/eslint-config": "8.4.5",
    "@types/bun": "1.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.9.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
